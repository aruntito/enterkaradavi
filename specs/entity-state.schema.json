{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/aruntito/enterkaradavi/blob/main/specs/entity-state.schema.json",
  "title": "KARADAVI Entity State",
  "description": "Experimental v0.1 public envelope for machine-readable entity state.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "type", "state"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "type": { "enum": ["entity", "source", "event", "artifact"] },
    "state": { "enum": ["unknown", "ambiguous", "supported", "conflicting", "unsupported", "disproven"] },
    "label": { "type": "string" },
    "identifiers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["value"],
        "properties": {
          "scheme": { "type": "string" },
          "value": { "type": "string", "minLength": 1 }
        }
      }
    },
    "claims": { "type": "array", "items": { "$ref": "claim.schema.json" } },
    "evidence": { "type": "array", "items": { "$ref": "evidence.schema.json" } },
    "provenance": { "type": "array", "items": { "$ref": "provenance.schema.json" } },
    "authority": { "$ref": "authority.schema.json" },
    "trust_signals": { "type": "array", "items": { "$ref": "trust-signal.schema.json" } },
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "material": { "type": "boolean" },
        "types": { "type": "array", "items": { "enum": ["missing", "conflict", "identity", "staleness", "method", "other"] } },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
