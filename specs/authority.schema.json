{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/aruntito/enterkaradavi/blob/main/specs/authority.schema.json",
  "title": "KARADAVI Authority Context",
  "description": "Context in which a source or actor has standing for a claim.",
  "type": "object",
  "additionalProperties": false,
  "required": ["subject", "scope", "basis"],
  "properties": {
    "subject": { "type": "string", "minLength": 1 },
    "scope": { "type": "string", "minLength": 1 },
    "basis": { "type": "string", "minLength": 1 },
    "valid_from": { "type": "string", "format": "date-time" },
    "valid_until": { "type": "string", "format": "date-time" },
    "limitations": { "type": "array", "items": { "type": "string" } }
  }
}
